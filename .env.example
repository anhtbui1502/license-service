# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Database
DB_PASSWORD=change-me

# Người duyệt nhận OTP (giám đốc)
APPROVER_EMAIL=giamdoc@vht.com.vn
APPROVER_NAME=Giám đốc

# Khóa HMAC băm OTP (>= 32 ký tự ngẫu nhiên, ví dụ: openssl rand -hex 32)
OTP_HMAC_SECRET=

# Tài khoản ADMIN đầu tiên (chỉ dùng khi DB chưa có người dùng)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@vht.com.vn

# SMTP nội bộ. Mặc định trỏ vào mailpit (chỉ để dev, xem mail tại http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=license-manager@vht.com.vn

# Đặt true khi chạy sau HTTPS
SESSION_COOKIE_SECURE=false
